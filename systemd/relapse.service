[Unit]
Description=Relapse dev stack (DNS spoofer + HTTPS handler + API server)
After=network.target

[Service]
Type=simple
# Adjust to taste, or override with a drop-in: systemctl edit relapse
Environment=SPOOF_DNS=192.168.1.1
Environment=REAL_DNS=8.8.8.8
Environment=HTTP_PORT=8080
Environment=CERT_PEM=/home/user/relapse-dev/dns-server/cert.pem
Environment=KEY_PEM=/home/user/relapse-dev/dns-server/key.pem
WorkingDirectory=/home/user/relapse-dev
ExecStart=/bin/sh -ec '\
  node dns-server/dns.js --ip "$SPOOF_DNS" --upstream "$REAL_DNS" & \
  node dns-server/https.js --ip "$SPOOF_DNS" --cert "$CERT_PEM" --key "$KEY_PEM" & \
  node api/serve.js "$HTTP_PORT" & \
  wait'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
